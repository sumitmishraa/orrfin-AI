# Required for a protected deployed demo. Use long, unique values.
DEMO_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./vendormind.db
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=vendormind-demo
# Set to 1 behind HTTPS in deployment.
COOKIE_SECURE=0

# Separate Supabase project for the pilot; secrets are server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vendormind-invoices
GOOGLE_PLACES_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Set only after running and verifying the RLS security setup on the dedicated pilot database.
PILOT_RLS_READY=0
