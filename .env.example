# Run `python tools/bootstrap_env.py` to create .env with generated secrets.
POSTGRES_PASSWORD=
ORRFIN_OWNER_DB_PASSWORD=
ORRFIN_APP_DB_PASSWORD=
ORRFIN_SECRET_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional. Leave blank and the feature stays off (the app says so instead of faking it).
ANTHROPIC_API_KEY=
ORRFIN_AI_PROVIDER=anthropic
ORRFIN_AI_MODEL=claude-opus-5-5
GROQ_API_KEY=
# Google Gemini. Used automatically when it's the only AI key set. GEMINI_MODEL defaults to gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
TINYFISH_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Deployment
ORRFIN_PORT=8080
PUBLIC_APP_URL=http://localhost:8080
COOKIE_SECURE=0
ORRFIN_ALLOW_SIGNUP=1
ORRFIN_ALLOW_MOCK_ERP=1

# One-click persona sign-in on /login, only for the fictional seeded company. Set 0 for real deployments.
ORRFIN_DEMO_LOGIN=1
