{
	auto_https off
	admin off
}

:80 {
	encode gzip

	request_body {
		max_size 30MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
