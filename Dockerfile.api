FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY alembic.ini ./
COPY orrfin ./orrfin
COPY mock_erp ./mock_erp
COPY tools ./tools
COPY tests ./tests

RUN useradd --system --uid 10001 --home-dir /srv orrfin
USER orrfin

CMD ["uvicorn", "orrfin.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
